---
const {
  align = 'center',
  width = 'fit-content',
  stack = 'vertical',
  bgColor, // Now optional - will use CSS variable defaults
  bleed = true,
  // If stack is horizontal, default prose width to '50ch' (like tables)
  // Otherwise default to '65ch' (standard readable line length)
  proseWidth = stack === 'horizontal' ? '40ch' : '65ch',
  class: className,
  ...props
} = Astro.props;

const html = await Astro.slots.render('default');

// Check if this card contains math/equations
const containsMath = html.includes('katex') || html.includes('mjx-container') || html.includes('MathJax');

// Simple robust string extraction for trailing <sub>
let content = html;
let caption = '';

const trimmedParams = html.trim();
if (trimmedParams.endsWith('</sub>')) {
    // Find the last opening sub tag
    // We are looking for the last <sub> that pairs with the final </sub>
    // This is a naive check: finding the last index of "<sub" before the end
    const lastSubIndex = trimmedParams.lastIndexOf('<sub');

    if (lastSubIndex !== -1) {
        // Basic check to see if this constitutes the "end" of the string
        // We compare the length of the string from that point to the end vs the content
        // But since we know it ends with </sub>, we just need to be careful not to cut off nested subs incorrectly.
        // For this specific feature (caption at the end), we assume the user puts the sub tag *after* the main content.

        // Let's verify no other content follows it (we already trimmed)
        // Extract
        const potentialCaption = trimmedParams.substring(lastSubIndex);

        // Remove the sub tags to get the inner HTML
        // This regex handles attributes in sub if any, though usually none for simple markdown
        const match = potentialCaption.match(/^<sub[^>]*>(.*)<\/sub>$/s);

        if (match) {
            caption = match[1];
            // The content is everything before the lastSubIndex
            // We use the original html string but slice based on finding that same substring
            // to preserve whitespace in the main content if needed, though trimming usually safer for layout.
            // Let's rely on the trimmed version's index logic but apply to the original if possible,
            // or just use trimmedParams.
            content = trimmedParams.substring(0, lastSubIndex);
        }
    }
}

// Build inline style
const inlineStyle = [
    bgColor ? `background-color: ${bgColor};` : '',
    `width: ${width};`,
].filter(Boolean).join(' ');
---

<div
    class:list={[
        'content-card-wrapper',
        align === 'center' && 'justify-center',
        align === 'start' && 'justify-start',
        align === 'end' && 'justify-end',
        bleed && 'content-card-bleed',
        className
    ]}
    {...props}
>
    <div
        class:list={[
            'content-card',
            caption && 'has-caption',
            // containsMath && 'no-hover'
        ]}
        style={inlineStyle}
    >
        <div
            class:list={[
                'card-content',
                stack === 'horizontal' && 'horizontal-stack'
            ]}
            data-stack={stack}
        >
            <Fragment set:html={content} />
        </div>

        {caption && (
            <div class="card-caption">
                <Fragment set:html={caption} />
            </div>
        )}
    </div>
</div>

<style>
    @reference "../styles/global.css";

    .content-card-wrapper {
        @apply flex w-full;
    }

    .content-card {
        @apply flex flex-col max-w-full overflow-hidden box-border;
        border: 1px solid var(--sl-color-gray-5);
        border-radius: var(--radius-box, 0.75rem);
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
        /* Default background - distinct from code blocks */
        background-color: var(--sl-color-gray-6);
    }

    /* Dark mode: use a distinct shade from code blocks */
    [data-theme='dark'] .content-card {
        background-color: oklch(34% 0.02 260);
    }

    .content-card:hover:not(.no-hover) {
        /* transform: translateY(-2px); */
        /* border-color: var(--sl-color-accent); */
        /* box-shadow: 0 8px 24px -6px oklch(0% 0 0 / 0.1); */
    }

    /* No hover effects for math/equation cards */
    .content-card.no-hover {
        /* transition: none; */
    }

    .card-content {
        @apply flex flex-col w-full gap-4 p-4 items-center max-w-full [&>*]:max-w-full;
        --cc-prose-width: v-bind(proseWidth);
    }

    /* Horizontal stack: text on left, code on right */
    .card-content.horizontal-stack {
        @apply flex flex-col items-start;
    }

    @media (min-width: 40rem) {
        .card-content.horizontal-stack {
            @apply flex-row items-center justify-between gap-8;
        }

        /* Text content on the left */
        /* .card-content.horizontal-stack :global(> *:not(.expressive-code):not(pre)) {
            flex: 1;
            min-width: 0;
            text-align: left;
        } */

        /* Code blocks on the right */
        /* .card-content.horizontal-stack :global(> .expressive-code),
        .card-content.horizontal-stack :global(> pre) {
            flex: 1;
            min-width: 0;
            max-width: 50%;
        } */
    }

    .card-caption {
        @apply text-center py-2 px-4 mt-0 w-full;
        font-size: var(--sl-text-sm);
        background-color: var(--sl-color-gray-5);
        color: var(--sl-color-gray-2);
    }

    /* Constrain prose width for direct children */
    .card-content :global(> p),
    .card-content :global(> ul > li),
    .card-content :global(> ol > li) {
        max-width: var(--cc-prose-width, none);
        width: 100%;
    }

    /* Responsive padding */
    @media (min-width: 40rem) {
        .card-content {
            @apply p-6;
        }
    }
</style>



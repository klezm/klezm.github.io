---
/**
 * Site navigation in the footer.
 *
 * The site runs with `hasSidebar = false` everywhere, which also removes
 * Starlight's mobile menu button — and starlight-blog puts its mobile "Blog"
 * link inside that menu, while its header link is hidden below 50rem. Without
 * this row there is no way to reach the blog index from a post on a phone.
 */
import Default from '@astrojs/starlight/components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const links = [
  { href: `${base}/`, label: 'Home' },
  { href: `${base}/blog/`, label: 'Blog' },
  { href: `${base}/blog/rss.xml`, label: 'RSS' },
  { href: 'https://github.com/klezm', label: 'GitHub' },
];
---

<nav class="site-nav" aria-label="Site">
  <ul>
    {
      links.map((link) => (
        <li>
          <a href={link.href}>{link.label}</a>
        </li>
      ))
    }
  </ul>
</nav>

<Default />

<style>
  .site-nav {
    margin-block-end: 1rem;
    padding-block-end: 1rem;
    border-block-end: 1px solid var(--sl-color-hairline);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
    text-decoration: none;
  }

  a:hover {
    color: var(--sl-color-text-accent);
    text-decoration: underline;
  }
</style>

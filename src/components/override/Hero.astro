---
import type { StarlightRouteData as Props } from '@astrojs/starlight/route-data';
import Default from '@astrojs/starlight/components/Hero.astro';

const { hero } = Astro.locals.starlightRoute.entry.data;

const isHeroEmpty = hero && Object.keys(hero).length === 0;
const isHeroEmptyish =
	hero &&
	Object.values(hero).every((val) => {
		if (val === undefined || val === null || val === '') return true;
		if (Array.isArray(val) && val.length === 0) return true;
		if (typeof val === 'object' && Object.keys(val).length === 0) return true;
		return false;
	});

// Hide the Hero if it's an empty object or all its properties are empty
const shouldHide = isHeroEmpty || isHeroEmptyish;
---

{!shouldHide && <Default {...Astro.props} />}

---
/**
 * `starlight-blog` and `starlight-image-zoom` both want to own
 * `MarkdownContent`. image-zoom claims it only when it is still free, and blog
 * warns and skips when it is already taken — so whichever plugin registers
 * first wins and the other silently loses its feature. Owning the override
 * here and rendering both is the only way to keep post metadata *and* image
 * zoom.
 *
 * It also carries `.blog-content-wrapper`, the hook the full-bleed grid in
 * `src/styles/global.css` targets, and mounts the footnote popovers.
 */
import BlogMarkdownContent from 'starlight-blog/overrides/MarkdownContent.astro';
import ImageZoom from 'starlight-image-zoom/components/ImageZoom.astro';
import FootnotePopovers from '../FootnotePopovers.astro';

const { id, entry } = Astro.locals.starlightRoute;

// The generated list/tag/author routes live under `blog/` too, but have no date.
const isPost = id.startsWith('blog/') && entry.data.date !== undefined;
---

<ImageZoom />
{
  isPost ? (
    <div class="blog-content-wrapper">
      <BlogMarkdownContent>
        <slot />
      </BlogMarkdownContent>
      <FootnotePopovers />
    </div>
  ) : (
    <BlogMarkdownContent>
      <slot />
    </BlogMarkdownContent>
  )
}

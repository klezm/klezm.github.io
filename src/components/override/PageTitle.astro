---
import Default from '@astrojs/starlight/components/PageTitle.astro';

const { entry } = Astro.locals.starlightRoute;
const { hide_title } = entry.data;
---

{
	!hide_title ? (
		<Default />
	) : (
		// ContentPanel looks for this attribute to hide the whole title panel.
		<div hide-page-title />
	)
}

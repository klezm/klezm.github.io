---
import type { StarlightRouteData as Props } from '@astrojs/starlight/route-data';
import Default from '@astrojs/starlight/components/PageTitle.astro';

const { entry } = Astro.locals.starlightRoute;
const { hide_title } = entry.data;
---

{
	!hide_title ? (
		<Default {...Astro.props} />
	) : (
        // ContentPanel will check for this attribute to hide itself
		<div hide-page-title />
	)
}


---
import { Icon } from '@astrojs/starlight/components';
---

<starlight-theme-select>
	<button
		type="button"
		aria-label={Astro.locals.t('themeSelect.accessibleLabel')}
		title={Astro.locals.t('themeSelect.accessibleLabel')}
		class="theme-toggle group"
	>
		<Icon name="sun" class="block dark:group-hover:block dark:hidden group-hover:hidden" />
		<Icon name="moon" class="hidden dark:group-hover:hidden dark:block group-hover:block" />
	</button>
</starlight-theme-select>

{/* Inlined to avoid FOUC. Uses global scope from `ThemeProvider.astro` */}
<script is:inline>
	StarlightThemeProvider.updatePickers();
</script>

<style>
	.theme-toggle {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.5rem;
		height: 2.5rem;
		padding: 0;
		border: 0;
		border-radius: 0.375rem;
		background: transparent;
		cursor: pointer;
		color: var(--sl-color-gray-2);
		transition: color 150ms ease, background-color 150ms ease;
	}

	.theme-toggle:hover {
		color: var(--sl-color-white);
		background-color: var(--sl-color-gray-6);
	}

	.theme-toggle:focus-visible {
		outline: 2px solid var(--sl-color-text-accent);
		outline-offset: 2px;
	}

	@media (prefers-reduced-motion: reduce) {
		.theme-toggle {
			transition: none;
		}
	}
</style>

<script>
	type Theme = 'auto' | 'dark' | 'light';

	class StarlightThemeSelect extends HTMLElement {
		constructor() {
			super();
			const button = this.querySelector('button');
			const storageKey = 'starlight-theme';

			const loadTheme = (): Theme => {
				const theme = typeof localStorage !== 'undefined' && localStorage.getItem(storageKey);
				return (theme === 'light' || theme === 'dark' || theme === 'auto') ? theme : 'auto';
			};

			const storeTheme = (theme: Theme) => {
				if (typeof localStorage !== 'undefined') {
					localStorage.setItem(storageKey, theme === 'auto' ? '' : theme);
				}
			};

			const getPreferredColorScheme = (): Theme =>
				matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';

			const updateTheme = (theme: Theme) => {
				const resolvedTheme = theme === 'auto' ? getPreferredColorScheme() : theme;
				document.documentElement.dataset.theme = resolvedTheme;
				storeTheme(theme);
				// Sync with other pickers if they exist (e.g. mobile menu)
				if (window.StarlightThemeProvider) {
					window.StarlightThemeProvider.updatePickers(theme);
				}
				// starlight-giscus re-themes the comment iframe when it sees a
				// `change` event on `<starlight-theme-select>`. Stock Starlight
				// uses a <select>, which bubbles one for free; this override is a
				// <button>, so it has to announce the change itself.
				this.dispatchEvent(new Event('change', { bubbles: true }));
			};

			if (button) {
				button.addEventListener('click', () => {
					const currentTheme = loadTheme();
					let newTheme: Theme;

					if (currentTheme === 'auto') {
						// If currently auto, toggle to the opposite of what's currently active
						newTheme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
					} else {
						newTheme = currentTheme === 'dark' ? 'light' : 'dark';
					}

					updateTheme(newTheme);
				});
			}

			// Listen for system changes if we are in 'auto' mode
			matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
				if (loadTheme() === 'auto') {
					updateTheme('auto');
				}
			});
		}
	}

	customElements.define('starlight-theme-select', StarlightThemeSelect);
</script>

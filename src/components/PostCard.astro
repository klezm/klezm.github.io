---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'docs'>;
}

const { post } = Astro.props;
const { title, date, excerpt, tags, cover } = post.data;

// `cover` is a union: a single `image`, or a `light`/`dark` pair.
const coverImage =
  cover && 'image' in cover ? cover.image : cover ? cover.light : undefined;

const href = `${import.meta.env.BASE_URL}${post.id}/`.replace(/\/{2,}/g, '/');

const formattedDate = date
  ? new Intl.DateTimeFormat('en', { dateStyle: 'long' }).format(date)
  : undefined;
---

<article class="post-card">
  <a class="post-card-link" href={href}>
    {
      coverImage && (
        <div class="post-card-media">
          {typeof coverImage === 'string' ? (
            <img src={coverImage} alt={cover?.alt ?? ''} loading="lazy" />
          ) : (
            <Image
              src={coverImage}
              alt={cover?.alt ?? ''}
              widths={[400, 800]}
              loading="lazy"
            />
          )}
        </div>
      )
    }
    <div class="post-card-body">
      <h3 class="post-card-title">{title}</h3>
      {date && <time datetime={date.toISOString()}>{formattedDate}</time>}
      {excerpt && <p class="post-card-excerpt">{excerpt}</p>}
      {
        tags && tags.length > 0 && (
          <ul class="post-card-tags">
            {tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        )
      }
    </div>
  </a>
</article>

<style>
  @reference "../styles/global.css";

  .post-card {
    @apply overflow-hidden rounded-lg;
    border: 1px solid var(--sl-color-gray-5);
    background-color: var(--sl-color-black);
    transition:
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  .post-card:hover {
    border-color: var(--sl-color-accent);
    transform: translateY(-2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .post-card,
    .post-card:hover {
      transition: none;
      transform: none;
    }
  }

  /* The whole card is the hit target, so the inner title must not double as a link. */
  .post-card-link {
    @apply flex flex-col h-full no-underline;
    color: inherit;
  }

  .post-card-media :global(img) {
    @apply w-full object-cover;
    aspect-ratio: 2 / 1;
  }

  .post-card-body {
    @apply flex flex-col gap-2 p-4;
  }

  .post-card-title {
    @apply m-0;
    font-size: var(--sl-text-h4);
    line-height: var(--sl-line-height-headings);
    color: var(--sl-color-white);
  }

  .post-card-body time {
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }

  .post-card-excerpt {
    @apply m-0;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }

  .post-card-tags {
    @apply flex flex-wrap gap-2 m-0 p-0 list-none;
  }

  .post-card-tags li {
    @apply rounded-full px-2 py-0.5;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-2);
    background-color: var(--sl-color-gray-6);
    border: 1px solid var(--sl-color-gray-5);
  }
</style>

---
interface Props {
	title: string;
	date: Date | string;
	excerpt?: string;
	href: string;
	tags?: string[];
	readingTime?: string;
}

const { title, date, excerpt, href, tags, readingTime } = Astro.props;

// Format date
const formattedDate = new Date(date).toLocaleDateString('en-US', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
});
---

<a href={href} class="blog-card group block no-underline">
	<article class="relative overflow-hidden rounded-xl border border-gray-200 bg-white p-6 shadow-sm transition-all duration-300 hover:shadow-lg hover:border-purple-300 dark:border-gray-700 dark:bg-gray-800 dark:hover:border-purple-500">
		<!-- Gradient accent bar -->
		<div class="absolute top-0 left-0 h-1 w-full bg-gradient-to-r from-purple-500 via-blue-500 to-cyan-500 opacity-70 transition-opacity duration-300 group-hover:opacity-100"></div>
		
		<!-- Content -->
		<div class="space-y-3">
			<!-- Date and reading time -->
			<div class="flex items-center gap-3 text-sm text-gray-500 dark:text-gray-400">
				<time datetime={new Date(date).toISOString()}>
					{formattedDate}
				</time>
				{readingTime && (
					<>
						<span class="text-gray-300 dark:text-gray-600">•</span>
						<span>{readingTime}</span>
					</>
				)}
			</div>

			<!-- Title -->
			<h2 class="text-xl font-bold text-gray-900 transition-colors duration-200 group-hover:text-purple-600 dark:text-white dark:group-hover:text-purple-400">
				{title}
			</h2>

			<!-- Excerpt -->
			{excerpt && (
				<p class="text-gray-600 line-clamp-2 dark:text-gray-300">
					{excerpt}
				</p>
			)}

			<!-- Tags -->
			{tags && tags.length > 0 && (
				<div class="flex flex-wrap gap-2 pt-2">
					{tags.map((tag) => (
						<span class="inline-flex items-center rounded-full bg-purple-50 px-2.5 py-0.5 text-xs font-medium text-purple-700 dark:bg-purple-900/30 dark:text-purple-300">
							{tag}
						</span>
					))}
				</div>
			)}

			<!-- Read more indicator -->
			<div class="flex items-center gap-1 pt-2 text-sm font-medium text-purple-600 dark:text-purple-400">
				<span>Read more</span>
				<svg class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
				</svg>
			</div>
		</div>
	</article>
</a>

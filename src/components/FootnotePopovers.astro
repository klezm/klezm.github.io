---
/**
 * Shows a footnote's text in a popover when its reference is hovered or
 * focused, so readers do not have to jump to the bottom of the page and back.
 *
 * Progressive enhancement: without JavaScript, or on a browser with no Popover
 * API, the references stay exactly what they already are — anchor links to the
 * footnotes section. Nothing is rewritten server-side.
 *
 * Uses JS positioning rather than CSS anchor positioning, which is still
 * Chromium-only; `getBoundingClientRect()` plus `position: fixed` works in
 * every browser that has `popover` at all.
 */
---

<footnote-popovers></footnote-popovers>

<style is:global>
  .footnote-popover {
    /* The UA sets `margin: auto` on popovers, which fights fixed positioning. */
    margin: 0;
    position: fixed;
    z-index: 100;
    max-width: min(38ch, calc(100vw - 2rem));
    padding: 0.75rem 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background-color: var(--sl-color-black);
    color: var(--sl-color-gray-2);
    box-shadow: 0 4px 16px rgb(0 0 0 / 0.2);
    font-size: var(--sl-text-sm);
    line-height: 1.5;
    /* Footnotes here are largely bare URLs, which otherwise overflow. */
    overflow-wrap: anywhere;
  }

  .footnote-popover ul {
    margin-block: 0.25rem;
    padding-inline-start: 1.25rem;
  }

  .footnote-popover > :first-child {
    margin-block-start: 0;
  }

  .footnote-popover > :last-child {
    margin-block-end: 0;
  }
</style>

<script>
  class FootnotePopovers extends HTMLElement {
    connectedCallback() {
      // Bail out entirely where the Popover API is missing; the plain anchor
      // links keep working.
      if (!('popover' in HTMLElement.prototype)) return;

      const refs = document.querySelectorAll<HTMLAnchorElement>(
        'a[data-footnote-ref]',
      );
      if (refs.length === 0) return;

      const HIDE_DELAY_MS = 120;

      for (const ref of refs) {
        const id = ref.getAttribute('href')?.slice(1);
        if (!id) continue;

        const footnote = document.getElementById(id);
        if (!footnote) continue;

        const popover = document.createElement('div');
        popover.className = 'footnote-popover';
        popover.popover = 'manual';

        // Clone so the real footnote list is left untouched, and drop the
        // "back to content" arrow, which is meaningless inside a popover.
        const content = footnote.cloneNode(true) as HTMLElement;
        for (const backref of content.querySelectorAll(
          'a[data-footnote-backref]',
        )) {
          backref.remove();
        }
        popover.append(...content.childNodes);
        document.body.append(popover);

        let hideTimer: ReturnType<typeof setTimeout> | undefined;

        const place = () => {
          const anchor = ref.getBoundingClientRect();
          const { width, height } = popover.getBoundingClientRect();
          const margin = 8;

          // Prefer above the reference; flip below when there is no room.
          const above = anchor.top - height - margin;
          popover.style.top = `${above >= margin ? above : anchor.bottom + margin}px`;

          const ideal = anchor.left + anchor.width / 2 - width / 2;
          const maxLeft = window.innerWidth - width - margin;
          popover.style.left = `${Math.max(margin, Math.min(ideal, maxLeft))}px`;
        };

        const show = () => {
          clearTimeout(hideTimer);
          if (popover.matches(':popover-open')) return;
          popover.showPopover();
          place();
        };

        const hide = () => {
          clearTimeout(hideTimer);
          if (popover.matches(':popover-open')) popover.hidePopover();
        };

        const hideSoon = () => {
          clearTimeout(hideTimer);
          // Grace period so the pointer can travel into the popover itself.
          hideTimer = setTimeout(hide, HIDE_DELAY_MS);
        };

        ref.addEventListener('pointerenter', show);
        ref.addEventListener('pointerleave', hideSoon);
        ref.addEventListener('focus', show);
        ref.addEventListener('blur', hide);
        // Let the anchor do its normal job when actually activated.
        ref.addEventListener('click', hide);

        popover.addEventListener('pointerenter', () => clearTimeout(hideTimer));
        popover.addEventListener('pointerleave', hideSoon);
      }

      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;
        for (const open of document.querySelectorAll<HTMLElement>(
          '.footnote-popover:popover-open',
        )) {
          open.hidePopover();
        }
      });
    }
  }

  customElements.define('footnote-popovers', FootnotePopovers);
</script>

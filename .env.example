# Umami analytics. Copy to `.env` to instrument a local build, or set these as
# repository variables so the deploy workflow picks them up.
#
# Without PUBLIC_UMAMI_WEBSITE_ID no analytics tag is emitted at all, and it is
# never emitted during `pnpm dev` regardless.
#
# The PUBLIC_ prefix is required — Astro only exposes variables to the client
# bundle under that prefix.

PUBLIC_UMAMI_WEBSITE_ID=
# Only needed when self-hosting; defaults to Umami Cloud.
# PUBLIC_UMAMI_SRC=https://analytics.example.com/script.js
